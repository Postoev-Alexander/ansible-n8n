services:
  traefik:
    image: "traefik:latest"
    container_name: traefik
    restart: always
    command:
      {% set traefik_cmd = [
        "--api=true",
        "--api.dashboard=true",
        "--api.insecure=" ~ ('true' if traefik_api_insecure else 'false'),
        "--providers.docker=true",
        "--providers.docker.exposedbydefault=false",
        "--providers.docker.network=" ~ traefik_docker_network_name,
        "--entrypoints.web.address=:80",
        "--entrypoints.websecure.address=:443",
        "--entrypoints.web.http.redirections.entrypoint.to=websecure",
        "--entrypoints.web.http.redirections.entrypoint.scheme=https",
        "--certificatesresolvers.mytlschallenge.acme.tlschallenge=true",
        "--certificatesresolvers.mytlschallenge.acme.email=" ~ traefik_ssl_email,
        "--certificatesresolvers.mytlschallenge.acme.storage=/letsencrypt/acme.json"
      ] %}
      {% if traefik_enable_dashboard_access %}
      {%   set _ = traefik_cmd.append('--entrypoints.traefik_api.address=:' ~ traefik_dashboard_port) %}
      {% endif %}
      {% for cmd in traefik_cmd %}
      - "{{ cmd }}"
      {% endfor %}

    ports:
      {% set traefik_ports = ["80:80", "443:443"] %}
      {% if traefik_enable_dashboard_access %}
      {%   set _ = traefik_ports.append(traefik_dashboard_port ~ ":" ~ traefik_dashboard_port_in) %}
      {% endif %}
      {% for port in traefik_ports %}
      - "{{ port }}"
      {% endfor %}

    volumes:
      - "{{ traefik_volume_name }}:/letsencrypt"
      - /var/run/docker.sock:/var/run/docker.sock:ro

    networks:
      - "{{ traefik_docker_network_name }}"

networks:
  "{{ traefik_docker_network_name }}":
    external: true

volumes:
  "{{ traefik_volume_name }}":
    external: true